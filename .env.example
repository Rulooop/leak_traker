# Copia este archivo a .env y rellena los valores reales. No subas .env a GitHub.

# URL de la BBDD (déjalo vacío en local para usar SQLite por defecto)
DATABASE_URL=

# Clave secreta para firmar los tokens de sesión (JWT) del login.
# Genera una aleatoria, por ejemplo con: openssl rand -hex 32
SECRET_KEY=

# Email/contraseña de tu cuenta admin. Al arrancar el servidor, si no existe
# ya un usuario con este email se crea como admin (role=admin); si ya existe,
# se le promociona a admin. Rellénalo solo la primera vez (o si necesitas
# promocionar a otra cuenta), luego puedes dejarlo vacío.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Webhook de Slack/Telegram/Discord para las alertas de filtración
ALERT_WEBHOOK_URL=

# Bot de Telegram para las alertas (token de BotFather y chat_id destino)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Orígenes permitidos por CORS en el backend (separados por coma, o * para todos)
ALLOWED_ORIGINS=*

# Clave de la API de Anthropic (Claude) para el chat de soporte con IA del
# dashboard. Opcional: si no se define, POST /support-chat responde con un
# error 500 controlado en vez de tumbar el servidor.
ANTHROPIC_API_KEY=
